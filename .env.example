# ============================================================
# Course Content Simplification Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# ------------------------------------------------------------------
# WATSONX_API_KEY
# Your IBM Cloud API key. Used to authenticate all watsonx.ai calls.
#
# How to find it:
#   1. Go to https://cloud.ibm.com
#   2. Click the top-right account menu → "Manage" → "Access (IAM)"
#   3. In the left sidebar click "API keys"
#   4. Click "Create an IBM Cloud API key", give it a name, copy the key.
#      (You will only see the key value once — save it immediately.)
# ------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# ------------------------------------------------------------------
# WATSONX_PROJECT_ID
# The GUID of your watsonx.ai project. Required by ModelInference to
# scope requests to your project.
#
# How to find it:
#   1. Go to https://dataplatform.cloud.ibm.com (IBM watsonx.ai)
#   2. Open your project (or create one under "New project")
#   3. Click the "Manage" tab inside the project
#   4. Under "General" → "Details" you will see "Project ID" — copy it.
# ------------------------------------------------------------------
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ------------------------------------------------------------------
# WATSONX_URL
# The regional endpoint URL for your watsonx.ai instance.
# Choose the URL that matches the IBM Cloud region where your
# watsonx.ai project was created.
#
# Region → URL mapping:
#   Dallas (us-south)  : https://us-south.ml.cloud.ibm.com
#   Frankfurt (eu-de)  : https://eu-de.ml.cloud.ibm.com
#   London (eu-gb)     : https://eu-gb.ml.cloud.ibm.com
#   Tokyo (jp-tok)     : https://jp-tok.ml.cloud.ibm.com
#
# If you used the default "Dallas" region when creating your IBM Cloud
# account, use the us-south URL.
# ------------------------------------------------------------------
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ------------------------------------------------------------------
# WATSONX_MODEL_ID
# The model identifier for the Granite instruct model on watsonx.ai.
# The value below is the recommended default.
#
# Other available Granite instruct models (subject to your region):
#   ibm/granite-3-8b-instruct        (default — best balance)
#   ibm/granite-3-2b-instruct        (faster, lighter)
#   ibm/granite-13b-instruct-v2      (older generation)
#
# Check available models in your region:
#   watsonx.ai UI → "Model library" → filter by "Text generation"
# ------------------------------------------------------------------
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
